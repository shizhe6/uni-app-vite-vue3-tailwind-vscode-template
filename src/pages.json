{
  // 组件自动引入规则
  "easycom": {
    // 是否开启自动扫描
    "autoscan": true,
    // 以正则方式自定义组件匹配规则
    "custom": {
      // uni-ui 规则如下配置
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"

    }
  },
  "pages": [ // pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages

    {
      "path": "pages/my/my",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/category/category",
      "style": {
        "navigationBarTitleText": "分类"
      }
    },
    {
      "path": "pages/bookstore/bookstore",
      "style": {
        "navigationBarTitleText": "书城"
      }
    },
    {
      "path": "pages/bookshelf/bookshelf",
      "style": {
        "navigationBarTitleText": "书架"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "weapp-tailwindcss",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  	// 设置 TabBar，小程序底部导航栏的样式
  "tabBar": {
    // 设置tab栏文字的默认颜色
    "color": "#838383",
    // 设置tab栏文字的选中颜色
    "selectedColor": "#daa359",
    // 设置tab栏的背景颜色
    "backgroundColor": "#ffffff",
    // 设置tab栏上边框的颜色
    "borderStyle": "white",
    // 定义tab栏列表项，每个对象代表一个tab页
    "list": [
      {
        "text": "书城",
        "pagePath": "pages/bookstore/bookstore",
        "iconPath": "static/tabs/bookstore_default.png",
        "selectedIconPath": "static/tabs/bookstore_selected.png"
      },
      {
        "text": "分类",
        "pagePath": "pages/category/category",
        "iconPath": "static/tabs/category_default.png",
        "selectedIconPath": "static/tabs/category_selected.png"
      },
      {
        "text": "书架",
        "pagePath": "pages/bookshelf/bookshelf",
        "iconPath": "static/tabs/bookshelf_default.png",
        "selectedIconPath": "static/tabs/bookshelf_selected.png"
      },
      {
        "text": "我的",
        "pagePath": "pages/my/my",
        "iconPath": "static/tabs/user_default.png",
        "selectedIconPath": "static/tabs/user_selected.png"
      }
    ]
  }
}
